# WeatherCover frontend environment configuration.
#
# Copy this file to .env.local and fill in the deployed contract address
# for whichever StudioNet deployment you want the frontend to point at.
# Never commit .env.local (it is gitignored).
#
# This app never deploys contracts and never touches a private key -- see
# docs/DEPLOYMENT.md. Writes are signed by whatever wallet extension
# (MetaMask or compatible) the visitor connects in their own browser.

# The deployed WeatherResolveCover contract address on GenLayer StudioNet.
# Falls back to the last-verified Stage 7 address (see docs/DEPLOYMENT.md)
# if unset, purely so local dev has something real to point at by default.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0908545f451521D3760183976c7e6848Fc7Ac701
